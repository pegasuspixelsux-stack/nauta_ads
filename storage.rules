rules_version = '2';

// Fotos de embarcaciones: lectura pública. Cualquiera puede subir una foto nueva (el formulario
// de publicación no exige cuenta), pero solo el staff puede reemplazar o borrar.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['admin', 'manager', 'operator'];
    }

    match /boats/{boatId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isStaff();
    }
  }
}
