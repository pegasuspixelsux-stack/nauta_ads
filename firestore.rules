rules_version = '2';

// Público: ver avisos aprobados, leer la configuración, enviar una consulta (lead) y
// publicar un aviso sin cuenta (queda en revisión).
// Staff (admin / manager / operator): gestiona avisos y consultas.
// Los registros nuevos arrancan como "pending" y no pueden hacer nada hasta que un admin los promueva.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return get(profilePath()).data.role;
    }

    function isStaff() {
      return signedIn() && exists(profilePath()) && role() in ['admin', 'manager', 'operator'];
    }

    function isAdmin() {
      return isStaff() && role() == 'admin';
    }

    match /boats/{boatId} {
      // Público: solo avisos ya aprobados y pagos. El staff ve todo (incluye los en revisión).
      allow read: if resource.data.status in ['active', 'reserved'] || isStaff();
      // Cualquiera puede enviar un aviso sin registrarse, siempre que entre "en revisión",
      // sin pago ni destacado: solo el staff activa, cobra y destaca.
      allow create: if request.resource.data.status == 'pending_review'
                    && request.resource.data.featured == false
                    && request.resource.data.paid == false
                    && request.resource.data.paymentUrl == ''
                    && request.resource.data.plan in ['individual', 'broker_fleet']
                    && request.resource.data.builder is string
                    && request.resource.data.builder.size() > 0
                    && request.resource.data.builder.size() <= 100
                    && request.resource.data.model is string
                    && request.resource.data.model.size() <= 100
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.price is number
                    && request.resource.data.length is number
                    && request.resource.data.images is list
                    && request.resource.data.images.size() <= 12
                    && request.resource.data.soldAt == null;
      allow update, delete: if isStaff();

      // Contacto del anunciante: lo puede crear cualquiera junto con su aviso, solo lo lee el staff.
      match /private/{docId} {
        allow create: if docId == 'owner'
                      && existsAfter(/databases/$(database)/documents/boats/$(boatId))
                      && getAfter(/databases/$(database)/documents/boats/$(boatId)).data.status == 'pending_review'
                      && request.resource.data.keys().hasOnly(['name', 'email', 'phone'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 200
                      && request.resource.data.email is string
                      && request.resource.data.email.size() <= 320
                      && request.resource.data.phone is string
                      && request.resource.data.phone.size() <= 50;
        allow read, update, delete: if isStaff();
      }
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'phone', 'message', 'boatId', 'boatLabel', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 50
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.boatLabel is string
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is number;
      allow read, update, delete: if isStaff();
    }

    // Boletín: cualquiera puede suscribirse; solo el staff ve la lista.
    match /subscribers/{subId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.+@.+')
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.createdAt is number;
      allow read, update, delete: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // Self-registration only ever creates a pending profile.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
                    && request.resource.data.role == 'pending';
      // Admins can change roles, nothing else about a profile.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() && role() in ['admin', 'manager'];
    }
  }
}
